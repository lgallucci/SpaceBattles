<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>SpaceBattles</AssemblyName>
    <Product>Space Battles</Product>
    <AssemblyTitle>Space Battles</AssemblyTitle>
    <Description>Play Space Battles</Description>
    <Company>lgallucci</Company>
    <Authors>lgallucci</Authors>
    <Copyright>Copyright © 2026 lgallucci</Copyright>
    <Version>1.0.1</Version>
    <InformationalVersion>1.0.1</InformationalVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icon.bmp" />
    <EmbeddedResource Include="Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpaceBattlesGraphics\SpaceBattlesGraphics.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

</Project>
